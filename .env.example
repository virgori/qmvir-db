# Copy to .env at repo root — never commit .env (see .gitignore)
npmjs_token=
pypi_token=
github_token=

# Optional aliases (scripts accept these too)
# NPM_TOKEN=
# PYPI_TOKEN=
# GITHUB_TOKEN=
# GH_TOKEN=
#
# npm publish: run `npm login` once on this machine, then either session or npmjs_token works.
#   npm login
#   npm whoami
#   bash scripts/publish_packages.sh --npm-only
