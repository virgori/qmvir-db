# QM benchmark runner — same Docker network as Qdrant (all_container fairness).
#
# Build from repo root after: maturin build --out /tmp/qm_linux_wheels
#   cp /tmp/qm_linux_wheels/qmvir-*.whl docker-wheels/
FROM python:3.13-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends libgomp1 curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /bench

COPY docker-wheels/*.whl /tmp/wheels/
RUN pip install --no-cache-dir /tmp/wheels/*.whl \
        duckdb qdrant-client psycopg2-binary && \
    rm -rf /tmp/wheels && \
    python3 -c "import qm_engine; print('qm_engine OK')"

COPY scripts/ /bench/scripts/

ENV PYTHONPATH=/bench/scripts \
    QM_DEPLOYMENT=docker_bridge \
    QDRANT_DEPLOYMENT=docker_bridge \
    DUCKDB_DEPLOYMENT=in_process_embedded \
    BENCHMARK_HOST=quizzman

ENTRYPOINT ["bash"]
