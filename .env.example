# Copy to .env at repo root — never commit .env (see .gitignore)
github_token=
npmjs_token=
pypi_token=

# Optional aliases (scripts accept these too)
# NPM_TOKEN=
# PYPI_TOKEN=
# GITHUB_TOKEN=
# GH_TOKEN=
#
# npm: token tried first (npm whoami). If publish fails, use browser login:
#   bash scripts/publish_packages.sh --npm-only --npm-login
#
# HA cluster (opt-in — unset = single-node):
# Full guide: docs/ENTERPRISE_HA_GUIDE_VI.md | qm cluster guide --lang vi
# QM_CLUSTER_ENABLE=1
# QM_CLUSTER_TRANSPORT_PORT=55441
# QM_CLUSTER_LOCAL_ADDR=127.0.0.1:55441
# QM_CLUSTER_SHARDS_PER_GROUP=4
# QM_CLUSTER_SHARD_ENDPOINTS=0=127.0.0.1:55441,1=127.0.0.1:55441,2=127.0.0.1:55442,3=127.0.0.1:55442
# DDL (CREATE TABLE/INDEX, DROP, ALTER, TRUNCATE) auto fan-out to all nodes when >1 endpoint
# QM_CLUSTER_WAL_PEERS=127.0.0.1:55442
# QM_CLUSTER_WAL_SYNC=1
# QM_CLUSTER_2PC=1
# Witness arbiter (2-DC tie-break):
# QM_CLUSTER_WITNESS_PEERS=127.0.0.1:55443   # on data nodes
# QM_CLUSTER_WITNESS=1                       # on witness node only
